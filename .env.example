# ============================================================
# KP ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in real values.
# NEVER commit .env to Git.
# ============================================================

# ---- APPLICATION ------------------------------------------
APP_NAME=KP
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false
SECRET_KEY=CHANGE_THIS_TO_A_RANDOM_64_CHAR_HEX_STRING
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# ---- DATABASE (PostgreSQL + TimescaleDB) ------------------
DATABASE_URL=postgresql+asyncpg://kp_user:CHANGE_PASSWORD@localhost:5432/kp_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_ECHO=false

# ---- REDIS ------------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
REDIS_MAX_CONNECTIONS=50

# ---- DATA DIRECTORIES (use relative or ENV-based paths) ---
DATA_DIR=./data/storage
RAW_DATA_DIR=./data/storage/raw
MODEL_DIR=./models
LOG_DIR=./logs
EXPORT_DIR=./data/exports

# ---- MARKET DATA PROVIDERS --------------------------------
# Phase 1-4: yfinance (free, no key needed)
# Phase 5+: Configure one of the live providers below

DATA_PROVIDER=yfinance
# Options: yfinance | zerodha | angel | fyers | truedata | mock

# Zerodha Kite Connect (for live streaming)
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
ZERODHA_ACCESS_TOKEN=

# Angel One SmartAPI (alternative live feed)
ANGEL_API_KEY=
ANGEL_CLIENT_ID=
ANGEL_PASSWORD=
ANGEL_TOTP_SECRET=

# Fyers API (historical + live)
FYERS_APP_ID=
FYERS_SECRET_KEY=
FYERS_ACCESS_TOKEN=

# ---- NEWS / SENTIMENT PROVIDERS ---------------------------
NEWS_PROVIDER=none
# Options: newsapi | gnews | none

NEWS_API_KEY=
GNEWS_API_KEY=

# ---- OBJECT STORAGE (MinIO / S3-compatible) ---------------
OBJECT_STORAGE_ENABLED=false
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_KEY=minioadmin
OBJECT_STORAGE_SECRET=CHANGE_THIS
OBJECT_STORAGE_BUCKET=kp-data
OBJECT_STORAGE_REGION=ap-south-1

# ---- AI ASSISTANT (LLM) -----------------------------------
LLM_PROVIDER=none
# Options: openai | anthropic | local | none
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ---- SECURITY ---------------------------------------------
JWT_SECRET=CHANGE_THIS_TO_A_RANDOM_64_CHAR_HEX_STRING
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60
JWT_REFRESH_EXPIRY_DAYS=30

# ---- SERVER -----------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=3000
WORKERS=2

# ---- FEATURE FLAGS ----------------------------------------
FEATURE_FNO=false
FEATURE_NEWS=false
FEATURE_SENTIMENT=false
FEATURE_EARLY_MOVE=false
FEATURE_HISTORICAL_SIMILARITY=false
FEATURE_AI_ASSISTANT=false
FEATURE_PAPER_TRADING=true
FEATURE_BACKTESTING=true
FEATURE_MARKET_REPLAY=false

# ---- TIMEZONE ---------------------------------------------
EXCHANGE_TIMEZONE=Asia/Kolkata
SERVER_TIMEZONE=Asia/Kolkata

# ---- LOGGING ----------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=./logs/kp.log

# ---- MONITORING -------------------------------------------
PROMETHEUS_ENABLED=false
PROMETHEUS_PORT=9090
