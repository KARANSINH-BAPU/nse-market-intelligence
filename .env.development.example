# ============================================================
# KP DEVELOPMENT ENVIRONMENT
# Copy to .env for local development
# ============================================================

APP_NAME=KP
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=dev_secret_key_change_in_production_64chars_minimum_required

ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

DATABASE_URL=postgresql+asyncpg://kp_user:kp_dev_password@localhost:5432/kp_db
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_ECHO=false

REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
REDIS_MAX_CONNECTIONS=20

DATA_DIR=./data/storage
RAW_DATA_DIR=./data/storage/raw
MODEL_DIR=./models
LOG_DIR=./logs
EXPORT_DIR=./data/exports

DATA_PROVIDER=yfinance
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
ZERODHA_ACCESS_TOKEN=
ANGEL_API_KEY=
ANGEL_CLIENT_ID=
ANGEL_PASSWORD=
ANGEL_TOTP_SECRET=
FYERS_APP_ID=
FYERS_SECRET_KEY=
FYERS_ACCESS_TOKEN=

NEWS_PROVIDER=none
NEWS_API_KEY=
GNEWS_API_KEY=

OBJECT_STORAGE_ENABLED=false
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_KEY=minioadmin
OBJECT_STORAGE_SECRET=minio_dev_secret
OBJECT_STORAGE_BUCKET=kp-data
OBJECT_STORAGE_REGION=ap-south-1

LLM_PROVIDER=none
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

JWT_SECRET=dev_jwt_secret_change_in_production_64chars_minimum
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60
JWT_REFRESH_EXPIRY_DAYS=30

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=3000
WORKERS=1

FEATURE_FNO=false
FEATURE_NEWS=false
FEATURE_SENTIMENT=false
FEATURE_EARLY_MOVE=false
FEATURE_HISTORICAL_SIMILARITY=false
FEATURE_AI_ASSISTANT=false
FEATURE_PAPER_TRADING=true
FEATURE_BACKTESTING=true
FEATURE_MARKET_REPLAY=false

EXCHANGE_TIMEZONE=Asia/Kolkata
SERVER_TIMEZONE=Asia/Kolkata

LOG_LEVEL=DEBUG
LOG_FORMAT=json
LOG_FILE=./logs/kp.log

PROMETHEUS_ENABLED=false
PROMETHEUS_PORT=9090
